# ====================================================================
# CIVICFIX AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure values before starting services
# ====================================================================

# Environment & Debug
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PUBLIC_APP_URL=http://localhost:5173

# Security & Tokens
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-min-32-chars-long-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Local development default uses SQLite file: sqlite:///./civicfix.db
# For PostgreSQL with PostGIS in Docker or Cloud:
DATABASE_URL=sqlite:///./civicfix.db
# DATABASE_URL=postgresql://civicfix_user:your_password@localhost:5432/civicfix_db

# Object Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Map & Spatial Geocoding Configuration
# Options: "nominatim" (Public OSM with 1req/sec throttling & cache), "disabled"
MAP_GEOCODING_PROVIDER=nominatim
MAP_GEOCODING_API_KEY=
MAP_GEOCODING_USER_AGENT=CivicFix-AI-Platform/1.0 (contact: support@civicfix.gov)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_DEFAULT_CENTER_LAT=17.4399
MAP_DEFAULT_CENTER_LON=78.4983
MAP_DEFAULT_ZOOM=12

# Rate Limiting Configuration (Phase A)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_COMPLAINT_CREATE=10/minute
RATE_LIMIT_AI_ANALYSIS=10/minute
RATE_LIMIT_EMAIL_VERIFY=3/minute
# For local development: memory://
# For production multi-instance cluster: redis://redis:6379/0
RATE_LIMIT_STORAGE_URL=memory://
BEHIND_TRUSTED_PROXY=False
TRUSTED_PROXY_IPS=127.0.0.1,::1

# AI Intelligence Layer (Phase C)
# Options: "mock" (offline deterministic provider), "gemini" (Google Gen AI SDK)
AI_PROVIDER=mock
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.70
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
DUPLICATE_RADIUS_METERS=100.0
DUPLICATE_TIME_WINDOW_DAYS=14

# Real SMTP Email Configuration (Phase D)
EMAIL_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@civicfix.gov
SMTP_FROM_NAME=CivicFix AI
# Mutually exclusive: Use TLS for port 587 (STARTTLS), or SSL for port 465
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=15

# Single Government Admin Bootstrap Credentials
INITIAL_ADMIN_EMAIL=admin@civicfix.gov
INITIAL_ADMIN_PASSWORD=AdminSecure2026!
INITIAL_ADMIN_NAME=Municipal Commissioner
INITIAL_ADMIN_PHONE=+919876543210

# Service Level Agreements (in hours)
SLA_HOURS_P1=12
SLA_HOURS_P2=24
SLA_HOURS_P3=72
SLA_HOURS_P4=168
