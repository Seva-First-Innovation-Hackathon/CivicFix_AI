# ====================================================================
# CIVICFIX AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure strong secrets before starting services
# ====================================================================

# Environment & Debug
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PUBLIC_APP_URL=http://localhost:5173

# Security & Tokens
# REQUIRED in production! Generate a secure key with: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit CORS Allowlist (comma-separated or JSON array; never '*' in production)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGINS=

# Database Connection
# Local development default uses SQLite file: sqlite:///./civicfix.db
# In production PostgreSQL is REQUIRED:
DATABASE_URL=sqlite:///./civicfix.db
# DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/civicfix_db
POSTGRES_USER=civicfix_user
POSTGRES_PASSWORD=
POSTGRES_DB=civicfix_db

# Object Storage Configuration ("local" for dev/tests, "r2" or "s3" for durable production storage)
STORAGE_BACKEND=local
REQUIRE_DURABLE_STORAGE=false
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# Cloudflare R2 / S3-compatible private bucket credentials (NEVER put secrets in VITE_* variables)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_REGION=auto
STORAGE_PRESIGNED_TTL_SECONDS=300

# Map & Spatial Geocoding Configuration
MAP_GEOCODING_PROVIDER=disabled
MAP_GEOCODING_API_KEY=
MAP_GEOCODING_USER_AGENT=CivicFix-AI-Platform/1.0 (contact: support@civicfix.gov)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_DEFAULT_CENTER_LAT=17.4399
MAP_DEFAULT_CENTER_LON=78.4983
MAP_DEFAULT_ZOOM=12

# Durable Background Queue & Rate Limiting (Redis / ARQ)
# In production set QUEUE_BACKEND=redis and provide REDIS_URL
QUEUE_BACKEND=inline
REDIS_URL=
REQUIRE_REDIS=false
WORKER_MAX_JOBS=10
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=15
SLA_MONITOR_INTERVAL_MINUTES=5

RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_COMPLAINT_CREATE=10/minute
RATE_LIMIT_AI_ANALYSIS=10/minute
RATE_LIMIT_EMAIL_VERIFY=3/minute
RATE_LIMIT_STORAGE_URL=memory://
BEHIND_TRUSTED_PROXY=False
TRUSTED_PROXY_IPS=127.0.0.1,::1

# AI Intelligence Layer
# Options: "mock" (offline deterministic provider), "gemini" (Google Gen AI SDK)
AI_PROVIDER=mock
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.70
AI_HIGH_CONFIDENCE_THRESHOLD=0.80
AI_MEDIUM_CONFIDENCE_THRESHOLD=0.55
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
DUPLICATE_RADIUS_METERS=100.0
DUPLICATE_TIME_WINDOW_DAYS=14

# Real SMTP Email Configuration
EMAIL_ENABLED=False
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@civicfix.gov
SMTP_FROM_NAME=CivicFix AI
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT_SECONDS=15

# Single Government Admin Bootstrap & Optional Opt-In Demo Seeding
# Set INITIAL_ADMIN_PASSWORD in your protected secret store (never commit real passwords)
INITIAL_ADMIN_EMAIL=admin@civicfix.gov
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Municipal Commissioner
INITIAL_ADMIN_PHONE=

# Explicit Opt-In Local Development Demo Seeding (never enabled in production)
ALLOW_DEMO_SEEDING=false
DEMO_STAFF_PASSWORD=
DEMO_CREW_PASSWORD=
DEMO_CITIZEN_PASSWORD=

# Service Level Agreements (in hours)
SLA_HOURS_P1=12
SLA_HOURS_P2=24
SLA_HOURS_P3=72
SLA_HOURS_P4=168
