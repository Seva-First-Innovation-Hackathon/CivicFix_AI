# ====================================================================
# CIVICFIX AI FRONTEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Verified Key-Free Esri World Street Map Raster Tiles (HTTPS)
# ====================================================================

VITE_API_URL=
VITE_MAP_PROVIDER=esri_streets
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
VITE_MAP_SUBDOMAINS=a,b,c,d
VITE_MAP_ATTRIBUTION=Tiles &copy; Esri &mdash; see Esri's World Street Map attribution and usage terms
VITE_GEOCODING_PROVIDER=disabled

# Municipal Default View Coordinates (Defaults to Hyderabad demo center)
VITE_DEFAULT_MAP_CENTER_LAT=17.4399
VITE_DEFAULT_MAP_CENTER_LON=78.4983
VITE_DEFAULT_MAP_ZOOM=12
